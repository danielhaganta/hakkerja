# Copy to .env and adjust. Never commit .env.

# Async SQLAlchemy URL; the "+psycopg" part selects the psycopg 3 driver.
# Local default matches docker-compose.yml. For Neon, use its connection string
# with the scheme changed to postgresql+psycopg:// and ?sslmode=require kept.
DATABASE_URL=postgresql+psycopg://hakkerja:hakkerja@localhost:5433/hakkerja
